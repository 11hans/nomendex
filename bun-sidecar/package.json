{
    "name": "bun-react-template",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun run build:css && bun --hot src/server.ts",
        "build": "bunx tailwindcss -i ./src/input.css -o ./src/output.css && bun eslint ./src && bun run tsc --skipLibCheck --noEmit",
        "build:css": "bunx tailwindcss -i ./src/input.css -o ./src/output.css",
        "build:css:dev": "bunx tailwindcss -i ./src/input.css -o ./src/output.css --watch",
        "build:css:full": "bunx tailwindcss -i ./src/input.css -o ./src/output.css --content './src/**/*.{js,ts,jsx,tsx}' --safelist '*'",
        "logs": "bun tail-logs.ts",
        "agent": "bun run scripts/run-agent.ts",
        "build-dictionary": "bun run scripts/build-dictionary.ts"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^2.0.56",
        "@anthropic-ai/claude-agent-sdk": "0.1.76",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-alert-dialog": "^1.1.15",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-collapsible": "^1.1.12",
        "@radix-ui/react-context-menu": "^2.2.16",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-radio-group": "^1.3.8",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@raindrop-ai/claude-agent-sdk": "^0.0.13",
        "@socotra/modelcontextprotocol-sdk": "^1.21.0",
        "ai": "^5.0.116",
        "bun-plugin-tailwind": "^0.0.15",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "diff": "^8.0.2",
        "isomorphic-git": "^1.36.1",
        "js-yaml": "^4.1.1",
        "lucide-react": "^0.542.0",
        "prosemirror-commands": "^1.7.1",
        "prosemirror-example-setup": "^1.2.3",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-markdown": "^1.13.2",
        "prosemirror-model": "^1.25.4",
        "prosemirror-schema-list": "^1.5.1",
        "prosemirror-state": "^1.4.4",
        "prosemirror-view": "^1.41.4",
        "react": "^19.2.3",
        "react-day-picker": "^9.13.0",
        "react-dom": "^19.2.3",
        "react-resizable-panels": "^3.0.6",
        "react-router-dom": "^7.11.0",
        "sonner": "^2.0.7",
        "streamdown": "^1.6.10",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "^4.1.18",
        "zod": "^4.2.1"
    },
    "overrides": {
        "prosemirror-state": "^1.4.4",
        "prosemirror-view": "^1.41.4",
        "prosemirror-model": "^1.25.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@tailwindcss/cli": "^4.1.18",
        "@types/bun": "^1.3.5",
        "@types/js-yaml": "^4.0.9",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.50.1",
        "@typescript-eslint/parser": "^8.50.1",
        "eslint": "^9.39.2",
        "eslint-plugin-react-hooks": "^5.2.0",
        "knip": "^5.77.0"
    }
}
